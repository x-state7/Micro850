# Copy to .env and enter your MariaDB ingestion user's password.
# Never commit .env or put the root password in the project.
MARIADB_HOST=65.20.79.196
MARIADB_PORT=3306
MARIADB_DATABASE=ptechview_machine
MARIADB_USER=plc_ingest
MARIADB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# OFF matches the example command supplied by the operator but is UNSAFE over the Internet.
# Use verified TLS or a VPN/SSH tunnel for production.
MARIADB_TLS=off
# Set when MARIADB_TLS=verify: full path to a trusted CA certificate.
MARIADB_SSL_CA=
LOG_LEVEL=INFO

# INFO prints per-poll and per-sync events on terminal; DEBUG adds detailed logs.
# DEBUG file logs are always captured in rotating logs/<command>.log.
LOG_LEVEL=INFO
MICRO850_LOG_DIR=logs
